# Copy to .env.local and fill in. These are public OAuth client identifiers, never secrets.

# Microsoft Entra ID app (SPA platform, redirect URI http://localhost:5173/auth/callback/microsoft,
# delegated permission Files.ReadWrite.AppFolder only). Enables OneDrive backups. For the Android
# app add the platform "Mobile and desktop applications" with the redirect URI
# com.astats.budget://auth/callback/microsoft (same client id).
VITE_MS_CLIENT_ID=

# Google Cloud OAuth client, type "Web application", authorized JavaScript origin
# http://localhost:5173, scope https://www.googleapis.com/auth/drive.appdata only. No secret.
VITE_GOOGLE_CLIENT_ID=

# Android app: Google OAuth client type "Android" (package com.astats.budget, the signing
# certificate's SHA-1, Advanced settings → "Enable custom URI scheme"; redirect
# com.astats.budget:/oauth2redirect).
VITE_GOOGLE_ANDROID_CLIENT_ID=

# Dropbox app with "App folder" access, redirect URI http://localhost:5173/auth/callback/dropbox,
# permissions files.metadata.read, files.content.read, files.content.write. No secret. For the
# Android app also add the redirect URI com.astats.budget://auth/callback/dropbox.
VITE_DROPBOX_APP_KEY=
