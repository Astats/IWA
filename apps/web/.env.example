# Copy to .env.local and fill in. These are public OAuth client identifiers, never secrets.

# Microsoft Entra ID app (SPA platform, redirect URI http://localhost:5173/auth/callback/microsoft,
# delegated permission Files.ReadWrite.AppFolder only). Enables OneDrive backups.
VITE_MS_CLIENT_ID=

# Google Cloud OAuth client, type "Web application", authorized JavaScript origin
# http://localhost:5173, scope https://www.googleapis.com/auth/drive.appdata only. No secret.
VITE_GOOGLE_CLIENT_ID=
