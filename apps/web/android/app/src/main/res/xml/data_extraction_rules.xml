<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device through Android backup or device transfer: the SQLCipher ledger
     and the Keystore-encrypted plugin preferences cannot be restored on another device anyway.
     Users move data with the app's encrypted backups (BUILD_PLAN 2.3 / Phase 3). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
