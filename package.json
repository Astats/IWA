{
  "name": "budget-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "test": "vitest run --project \"!web-browser\"",
    "test:e2e": "playwright test --project=chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --project web-browser",
    "test:e2e:all": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test --project=chromium --grep @a11y",
    "test:security": "playwright test --project=chromium --grep @security",
    "size": "size-limit",
    "lhci": "pnpm dlx @lhci/cli@0.15.1 autorun"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "14.1.0",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "size-limit": "14.1.0",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
